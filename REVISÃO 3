 void exercicio4()
 {
    int numero;

    printf("Digite o numero de letras da palavra:\n");
    scanf("%d", &numero);

    char palavar[numero + 1];

    printf("Digite a palavra:\n");
    scanf(" %[^\n]", palavar);

    for (int i = 0; i < numero; i++)
    {
        if (palavar[i] >= 'a' && palavar[i] <= 'z')
        {
            palavar[i] = palavar[i] - 32;
        }

        if (palavar[i] >= 'A' && palavar[i] <= 'Z')
        {
            if (palavar[i] > 'Z' - 3)
            {
                palavar[i] = palavar[i] - 26;
            }

            palavar[i] = palavar[i] + 3;
        }

        printf("%c", palavar[i]);
    }
 }
 
