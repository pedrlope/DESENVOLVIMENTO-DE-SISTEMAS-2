 void exercicio2()
 {
  int matrix[2][2], x, y, d;
    x=1;
    y = 1;
    
    for(int i = 0; i<2; i++)
    {
        for (int j = 0; j<2; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }
    
    for(int i = 0; i<2; i++)
    {
        for (int j = 0; j<2; j++)
        {
           if(i == j)
           {
               x*=matrix[i][j];
           }
           else
           {
               y*=matrix[i][j];
           }
        }
    }
    d = x-y;
    printf("o  determinante da matriz eh:  \n%d", d);
 }

