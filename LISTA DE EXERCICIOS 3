     void exercicio11()
     {
         int m, n;
    int  array [100], vector[100], c[200];
    int i, j, k;
    printf("digite m\n");
    scanf("%d", &m);

    for (i = 0; i < m; i++) {
        scanf("%d", & array [i]);
    }
    printf("digite n\n");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &vector[i]);
    }

    i = 0;
    j = 0;
    k = 0;

    while (i < m && j < n) {
        if ( array [i] < vector[j]) {
            c[k] =  array [i];
            i++;
            k++;
        } else if ( array [i] > vector[j]) {
            c[k] = vector[j];
            j++;
            k++;
        } else {
            c[k] =  array [i];
            i++;
            j++;
            k++;
        }
    }

    while (i < m) {
        c[k] =  array [i];
        i++;
        k++;
    }

    while (j < n) {
        c[k] = vector[j];
        j++;
        k++;
    }

    for (i = 0; i < k; i++) {
        printf("%d ", c[i]);
    }

    printf("\n");
     }

